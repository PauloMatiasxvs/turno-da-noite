; Turno da Noite — projeto Godot 4
; A cena e montada por codigo em scripts/Bootstrap.cs a partir do nucleo C#
; em ../core. Nao ha cena complexa para manter a mao.

config_version=5

[application]

config/name="Turno da Noite"
config/description="Terror e sobrevivencia. A partida inteira vive em C# puro; o Godot renderiza."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.4", "C#", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="TurnoDaNoite"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.004, 0.005, 0.009, 1)
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3

[physics]

common/physics_ticks_per_second=60
