<Project Sdk="Godot.NET.Sdk/4.4.0">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>disable</Nullable>
    <RootNamespace>TurnoDaNoite.Jogo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fonte unica do jogo: os mesmos arquivos que os testes compilam.
         Mexer numa regra aqui quebra o teste la, que e exatamente o ponto. -->
    <Compile Include="..\core\**\*.cs" />
  </ItemGroup>

</Project>
